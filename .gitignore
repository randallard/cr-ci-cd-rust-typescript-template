# Secrets and local configuration. Real values live in the environment or the platform's
# secret store, never in the repo. Commit .env.example (placeholders only) instead.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_ed25519
credentials.json
secrets.toml
secrets.yaml
secrets.yml
*.secret

# Rust
/target/

# Node / TypeScript
node_modules/
dist/
coverage/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Python bytecode (docs-hygiene.py run locally)
__pycache__/
*.pyc
